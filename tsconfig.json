{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "declaration": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}

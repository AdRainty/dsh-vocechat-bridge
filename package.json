{
  "name": "dsh-vocechat-bridge",
  "version": "0.4.4",
  "type": "module",
  "description": "Native fixed-session VoceChat bridge for DeepSeek Harness with structured media and ASR",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdRainty/dsh-vocechat-bridge.git"
  },
  "homepage": "https://github.com/AdRainty/dsh-vocechat-bridge#readme",
  "bugs": {
    "url": "https://github.com/AdRainty/dsh-vocechat-bridge/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "vocechat", "bridge", "asr", "tts"],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/bridge.js",
    "./audio": "./dist/audio.js",
    "./speech": "./dist/speech.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "src",
    "client",
    "tests",
    "scripts",
    "tsconfig.json",
    "cordis.patch.yml",
    "config.example.yml",
    "README.md",
    "AGENTS.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=30000 tests/*.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  }
}
